# matchday-agent — environment template.
# Copy to .env for local dev. Never commit real values.

# ── LLM provider (see docs/decisions.md § 0.1). ──────────────────────────────
# Default = Groq (primary). To swap to Gemini, change the two lines to:
#   LLM_PROVIDER=google_genai
#   LLM_MODEL=gemini-3.5-flash          # pinned; reproducible
#   # or: LLM_MODEL=gemini-flash-latest  # alias; auto-updates to Google's current flash
# ⚠️ Gemini 2.5 line is closed to NEW API accounts as of 2026 — always use 3.x or -latest.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Provider API keys (only the one matching LLM_PROVIDER is required; harmless to have both).
GROQ_API_KEY=
GOOGLE_API_KEY=

# ── LangSmith observability (docs/decisions.md § 0.9). ───────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=matchday-agent

# ── Supabase Postgres — pgvector RAG + LangGraph checkpointer (§ 0.4). ───────
# Project: matchday-dev  ·  Region: <REGION>  ·  Ref: <PROJECT_REF>
#
# Pick ONE of these (session pooler recommended — works from anywhere, supports
# prepared statements). Replace <PROJECT_REF>, <REGION>, and <PASSWORD> with
# your values from Supabase dashboard → Project settings → Database →
# Connection string. Placeholders kept to avoid GitGuardian false positives.
#
# 1) Session pooler (RECOMMENDED for LangGraph checkpointer + pgvector):
#    postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
#
# 2) Transaction pooler (NOT recommended — prepared-statement edge cases):
#    postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
#
# 3) Direct connection (IPv6-only in current Supabase — may not work from Fly.io):
#    postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
#
# Verify the exact host/port on your dashboard: Get Connected → Session pooler.
DATABASE_URL=

# ── matchday-mcp subprocess (§ 0.2). ─────────────────────────────────────────
# Inherited by `npx matchday-mcp` via StdioServerParameters.env.
FOOTBALL_DATA_TOKEN=

# ── FastAPI (§ 0.5). ─────────────────────────────────────────────────────────
# Comma-separated CORS origins. Dev = also localhost.
ALLOWED_ORIGINS=https://matchday-mcp-web.vercel.app,http://localhost:5173

# ── Supabase MCP for Claude Code (only for dev / IDE use — see .mcp.json). ───
# Set this ONLY if you want headless / CI access; local Claude Code does OAuth on first use.
SUPABASE_ACCESS_TOKEN=
